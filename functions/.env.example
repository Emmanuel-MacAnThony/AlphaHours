# Copy to functions/.env and fill in. These are not secret.
OAUTH_CLIENT_ID=alpha-city-gpt
OPENAI_MODEL=gpt-4o-mini
# Slack channel ID for #hours-tracker (right-click the channel > View channel details > bottom of the About tab). Leave empty to switch off Slack.
SLACK_CHANNEL_ID=
# The app's public address, e.g. https://hours.yourcompany.com (used in links and the ChatGPT schema)
APP_URL=
